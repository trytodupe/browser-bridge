{
  "manifest_version": 2,
  "name": "browser-bridge",
  "version": "2.0.1",
  "description": "Zero-footprint on-demand browser bridge for coding agents.",
  "license": "MIT",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "webNavigation",
    "webRequest",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-bridge@trytodupe.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
