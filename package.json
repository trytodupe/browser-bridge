{
  "name": "browser-bridge",
  "version": "2.0.1",
  "description": "Zero-footprint on-demand Firefox bridge for coding agents",
  "scripts": {
    "lint": "web-ext lint --source-dir addon",
    "build": "web-ext build --source-dir addon --artifacts-dir dist --overwrite-dest",
    "sign": "./scripts/sign-xpi.sh",
    "dev": "web-ext run --source-dir addon --firefox=firefox",
    "test": "node --test tests/mcp-server.test.js"
  },
  "devDependencies": {
    "web-ext": "^8.0.0"
  }
}
